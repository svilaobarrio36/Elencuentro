# ── Turso (SQLite en la nube) ─────────────────────────────────────────────────
# Obtené estos valores con: turso db show el-encuentro --url
#                            turso db tokens create el-encuentro
TURSO_DATABASE_URL="libsql://el-encuentro-xxx.turso.io"
TURSO_AUTH_TOKEN="eyJ..."

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generá un valor random: openssl rand -base64 32
AUTH_SECRET="un-string-random-de-32-chars"

# ── URL de la app (Vercel lo setea automáticamente como VERCEL_URL) ───────────
NEXTAUTH_URL="https://tu-app.vercel.app"
